# PeopleOps Copilot — environment configuration.
# Copy to `.env` (gitignored) and fill in keys as needed. `.env.example`
# itself is committed and must never contain a real secret.
#
# ============================================================================
# READ THIS FIRST — the free-tier budget is the build's binding constraint
# ============================================================================
# OpenRouter's free tier is 20 requests/minute AND 50 model requests/day
# (rising to 1,000/day after a one-time $10 credit purchase — see PRD §5).
# 50/day is shared across every agent hitting this backend. That is why:
#
#   - LLM_PROVIDER=mock is the committed default below. Every build/dev
#     agent works against the deterministic mock provider
#     (backend/app/llm/mock.py) and NEVER spends real quota.
#   - Flip LLM_PROVIDER=openrouter only for: (a) the T+10 tool-calling-probe
#     gate check, (b) the final demo rehearsal. Flip it back to mock
#     immediately after.
#   - Never set LLM_PROVIDER=openrouter (or any hosted provider) inside a
#     Wave-1/2 build agent's environment. If you need to exercise a real
#     call while developing, do it manually, once, outside the agent loop.
#   - Free tiers generally train on submitted prompts. Fine for synthetic
#     seed data and the demo. Not fine for real resumes or real employee
#     questions — use the `ollama` profile (LLM_PROVIDER=ollama, no key,
#     no network) for anything real. This is called out again in /admin.
#
# ============================================================================

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml's `db` service. Only override the host/port if
# you're running the backend outside Compose against a different Postgres.
DATABASE_URL=postgresql+asyncpg://hr:hr@db:5432/hrdb

# --- LLM provider selection ---------------------------------------------------
# One of: mock | openrouter | groq | gemini | cerebras | ollama
# See backend/app/llm/provider.py:PROVIDERS for base URLs / default models.
LLM_PROVIDER=mock

# Used by the retry/backoff wrapper in backend/app/llm/throttle.py after 3
# failed attempts against LLM_PROVIDER on 429/502/503. Only used if the
# corresponding *_API_KEY below is set (or the provider needs none, e.g. ollama).
LLM_FALLBACK_PROVIDER=groq

# Requests/minute the shared token bucket allows. Default is under
# OpenRouter's 20 RPM free-tier ceiling.
LLM_RPM=18

# Hard daily cap enforced server-side against today's (UTC) audit_log row
# count. At this count the API returns {"error": {"code":
# "llm_budget_exhausted", ...}} instead of silently failing at the
# provider. Default (45) leaves headroom under OpenRouter's 50/day free cap.
LLM_DAILY_BUDGET=45

# Bounded concurrency pool for bulk resume evaluation (F5), sized to the
# provider's rate limit. Default 2 on OpenRouter.
EVAL_CONCURRENCY=2

# LLM-based rerank step in retrieval (F1). Off by default — it costs a
# third of every policy question's request budget for marginal recall gain.
RAG_RERANK=false

# --- Embeddings ---------------------------------------------------------------
# fastembed (default): local ONNX (BAAI/bge-small-en-v1.5, 384-dim), no key,
# no rate limit, no network call — baked into the backend image at build.
# Alternatives (gemini | jina) are wired but not the default; see PRD §5.
EMBEDDING_PROVIDER=fastembed

# --- Provider API keys ---------------------------------------------------------
# Leave unset while LLM_PROVIDER=mock. Set only the one(s) you're about to
# use for a gate check or the demo.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
# Ollama needs no key — it's the offline escape hatch (`docker compose
# --profile offline up`, LLM_PROVIDER=ollama). Not read by config.py; the
# base URL is fixed in PROVIDERS["ollama"] and points at the `ollama`
# compose service.

# --- Misc ------------------------------------------------------------------
# Used for OpenRouter's HTTP-Referer attribution header (PRD §5) and for
# links rendered anywhere the app needs its own origin.
APP_URL=http://localhost:5173

# dev | prod — informational; gates verbose logging, not app behavior.
ENV=dev

# debug | info | warning | error
LOG_LEVEL=info

# --- Postgres container settings (read by docker-compose.yml, not by the
# backend directly) ------------------------------------------------------------
POSTGRES_USER=hr
POSTGRES_PASSWORD=hr
POSTGRES_DB=hrdb
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
